# DATABASE
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD_HERE
DB_NAME=blablabook

# BACKEND / JWT
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@postgres:5432/blablabook?schema=public
JWT_SECRET=YOUR_VERY_SECURE_JWT_SECRET_MIN_32_CHARACTERS_HERE
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# FRONTEND
VITE_BACKEND_URL=http://localhost:3000

# DEMO ACCOUNT — read by frontend/http_test/api.http (REGISTER + LOGIN).
# Not seeded in DB: the .http file creates the account via /auth/register
# on the first run against a fresh DB.
DEMO_EMAIL=demo@blablabook.test
DEMO_USERNAME=demo
DEMO_PASSWORD=Demo123!Demo