{
  "buildCommand": "npm run build",
  "env": {
    "VITE_BACKEND_URL": "@vite_backend_url"
  },
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "frontend/dist/index.html"
    }
  ]
}
