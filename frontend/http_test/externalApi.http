@baseUrl = https://openlibrary.org
@coversBaseUrl = https://covers.openlibrary.org

### Example data (editable)
@searchText = Star Wars
@categoryName = fantasy
@randomLikeQuery = science
@isbn = 9780140328721
@workId = /works/OL83573W
@authorId = OL34184A
@editionKey = OL7723154M
@coverId = 15152634
@limit = 10
@offset = 0

### ------------------------------------------------------------------
### TEST - Check what fields are actually returned in editions
### ------------------------------------------------------------------
GET {{baseUrl}}/search.json?q={{searchText}}&limit=1&fields=key,title,author_name,editions,editions.key,editions.title,editions.isbn,editions.language,editions.covers
Accept: application/json

###

### ------------------------------------------------------------------
### 1) SEARCH - searchText mode (uses /search.json?q=...)
### With EDITIONS embedded - optimized to avoid 500+ requests!
### ------------------------------------------------------------------
GET {{baseUrl}}/search.json?q={{searchText}}&limit={{limit}}&offset={{offset}}&fields=key,title,author_name,first_publish_year,cover_i,editions,editions.key,editions.title,editions.isbn,editions.language,editions.covers
Accept: application/json

###

### ------------------------------------------------------------------
### 2) BOOK EDITION - edition details via edition_key
### Used in searchExternalBooks: /books/{editionKey}.json
### ------------------------------------------------------------------
GET {{baseUrl}}/books/{{editionKey}}.json
Accept: application/json

###

### ------------------------------------------------------------------
### 3) ISBN - edition by ISBN
### Used in getOpenLibIsbnData
### ------------------------------------------------------------------
GET {{baseUrl}}/isbn/{{isbn}}.json
Accept: application/json

###

### ------------------------------------------------------------------
### 4) WORK - work details
### Used in getOpenLibWorkData
### ------------------------------------------------------------------
GET {{baseUrl}}/works/{{workId}}.json
Accept: application/json

###

### ------------------------------------------------------------------
### 5) AUTHOR - author details
### Used in getOpenLibAuthorData
### ------------------------------------------------------------------
GET {{baseUrl}}/authors/{{authorId}}.json
Accept: application/json

###

### ------------------------------------------------------------------
### 6) COVER - cover image large format (used for book detail pages)
### ------------------------------------------------------------------
GET {{coversBaseUrl}}/b/id/{{coverId}}-L.jpg

###

### ------------------------------------------------------------------
### 7) COVER - cover image medium format (used for search results)
### ------------------------------------------------------------------
GET {{coversBaseUrl}}/b/id/{{coverId}}-M.jpg

###

### ------------------------------------------------------------------
### 8) SEARCH - category mode (uses /search.json?q=categoryName) - OPTIONAL
### ------------------------------------------------------------------
GET {{baseUrl}}/search.json?q={{categoryName}}&limit={{limit}}&offset={{offset}}&language=fre&fields=key,title,author_name,edition_key,subject
Accept: application/json

###

### ------------------------------------------------------------------
### 9) SEARCH - random mode (simulates a random query) - OPTIONAL
### ------------------------------------------------------------------
GET {{baseUrl}}/search.json?q={{randomLikeQuery}}&limit={{limit}}&offset={{offset}}&language=fre&fields=key,title,author_name,edition_key,subject
Accept: application/json

###